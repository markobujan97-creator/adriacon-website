# ============================================================
# Adriacon Treuhand GmbH – Umgebungsvariablen
# ------------------------------------------------------------
# Diese Datei wird eingecheckt und enthält KEINE echten Werte.
# Kopieren Sie sie lokal zu ".env.local" und tragen Sie dort
# Ihre Werte ein. ".env.local" wird nicht eingecheckt.
# ============================================================

# --- ERFORDERLICH ---------------------------------------------------------
# Öffentliche Basis-URL der Website, ohne abschliessenden Schrägstrich.
# Wird für Canonical-URL, Open Graph, sitemap.xml und robots.txt verwendet.
NEXT_PUBLIC_SITE_URL=https://www.adriacon.ch


# --- E-MAIL-VERSAND DES KONTAKTFORMULARS -----------------------------------
# Damit Formularanfragen per E-Mail bei info@adriacon.ch ankommen, muss
# mindestens RESEND_API_KEY gesetzt sein. Ohne diesen Schlüssel läuft das
# Formular im Demo-Modus: Die Anfrage wird angenommen und protokolliert,
# es wird aber KEINE E-Mail versendet. Der Build läuft trotzdem fehlerfrei.

# API-Schlüssel von Resend (https://resend.com) – niemals hier eintragen,
# sondern ausschliesslich in Vercel unter Settings > Environment Variables.
RESEND_API_KEY=

# Empfängeradresse. Ohne Angabe geht jede Anfrage an info@adriacon.ch.
CONTACT_TO_EMAIL=info@adriacon.ch

# Absenderadresse. Ohne Angabe wird die Testdomain von Resend verwendet.
# Für den produktiven Betrieb eine verifizierte Adresse der eigenen Domain
# eintragen, z. B. "Adriacon Website <website@adriacon.ch>".
CONTACT_FROM_EMAIL=
